BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# MongoDB Atlas connection string
# Example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hireloop?retryWrites=true&w=majority
MONGODB_URI=

# Public app URL used by the auth client
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated emails that skip approval and automatically become admins.
# Add your own email here, sign up with the Admin role, then approve recruiters at /admin.
# Example: ADMIN_EMAILS=you@example.com,cofounder@example.com
ADMIN_EMAILS=
